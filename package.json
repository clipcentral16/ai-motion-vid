{
  "name": "ai-motion-vid",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render SpinningObject out/spinning-object.mp4",
    "typecheck": "tsc --noEmit",
    "render:whatif": "remotion render WhatIfNoLegs out/what-if-no-legs.mp4 --crf=24",
    "audio": "node scripts/generate-audio.mjs",
    "narration": "python3 scripts/generate-narration.py scripts/narration/no-legs.json",
    "render:nuke": "remotion render WhatIfNuke out/what-if-nuke.mp4 --crf=24",
    "audio:nuke": "node scripts/generate-audio.mjs nuke",
    "narration:nuke": "python3 scripts/generate-narration.py scripts/narration/nuke.json",
    "render:jupiter": "remotion render JupiterIncident out/jupiter-incident.mp4 --crf=24",
    "audio:jupiter": "node scripts/generate-audio.mjs jupiter",
    "narration:jupiter": "python3 scripts/generate-narration.py scripts/narration/jupiter.json",
    "render:asteroid": "remotion render AsteroidSave out/asteroid-save.mp4 --crf=24",
    "audio:asteroid": "node scripts/generate-audio.mjs asteroid",
    "narration:asteroid": "python3 scripts/generate-narration.py scripts/narration/asteroid.json",
    "render:dumbtown": "remotion render DumbTown out/dumb-town.mp4 --crf=24",
    "audio:dumbtown": "node scripts/generate-audio.mjs dumbtown",
    "narration:dumbtown": "python3 scripts/generate-narration.py scripts/narration/dumbtown.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clipcentral16/ai-motion-vid.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/clipcentral16/ai-motion-vid/issues"
  },
  "homepage": "https://github.com/clipcentral16/ai-motion-vid#readme",
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "4.0.546",
    "@remotion/cli": "4.0.546",
    "@remotion/fonts": "4.0.546",
    "@remotion/three": "4.0.546",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.546",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
